{
  "name": "Acoustify",
  "short_name": "Acoustify",
  "description": "Live sessions and acoustic sets from the artists you love, song by song. Plays offline and in the background.",
  "id": "./",
  "start_url": "./#/home",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0a0a0b",
  "theme_color": "#0a0a0b",
  "categories": ["music", "entertainment"],
  "prefer_related_applications": false,
  "launch_handler": { "client_mode": "navigate-existing" },
  "shortcuts": [
    { "name": "Artists", "short_name": "Artists", "url": "./#/artists", "icons": [{ "src": "./assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Search", "short_name": "Search", "url": "./#/search", "icons": [{ "src": "./assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Library", "short_name": "Library", "url": "./#/library", "icons": [{ "src": "./assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] }
  ],
  "icons": [
    { "src": "./assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./assets/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "./assets/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
